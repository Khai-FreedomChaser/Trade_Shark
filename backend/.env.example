# --- Database ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tradshark
MYSQL_USER=tradshark
MYSQL_PASSWORD=
# --- JWT ---
JWT_ACCESS_SECRET=random_1_secret
JWT_REFRESH_SECRET=random_2_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Server ---
PORT=3636

# --- Market simulator & WebSocket  ---
SIM_ENABLED=true          # đặt "false" khi Backend 1 thay simulator riêng
TICK_INTERVAL_MS=1000     # mỗi bao lâu sim sinh 1 lượt tick toàn thị trường
TICK_RATIO=0.15           # tỉ lệ mã di chuyển mỗi tick (giữ payload WS gọn)
SIM_VOLATILITY=0.003      # biên độ random walk ±0.3%
BROADCAST_INTERVAL_MS=500 # chu kỳ gộp & đẩy frame ticks qua WS
SNAPSHOT_INTERVAL_MS=60000 # chu kỳ batch ghi stock_snapshots
SEED_COUNT=3000           # số mã seed mặc định (1.000 - 5.000)
MINMAX_SELFCHECK=false     # true: chạy thêm thuật toán tuần tự để tự kiểm chứng kết quả Min-Max (chỉ khi test)
ALERT_REFRESH_MS=60000     # chu kỳ làm mới cache cảnh báo trong RAM (đường nóng không truy vấn DB)
