# --- Database (docker compose đọc file này) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=tradshark
MYSQL_USER=tradshark
MYSQL_PASSWORD=

# --- Backend client (backend/.env nên trỏ về host) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Server & simulator ---
PORT=3636
SIM_ENABLED=true
TICK_INTERVAL_MS=1000
TICK_RATIO=0.15
SIM_VOLATILITY=0.003
BROADCAST_INTERVAL_MS=500
SNAPSHOT_INTERVAL_MS=60000
SEED_COUNT=3000
